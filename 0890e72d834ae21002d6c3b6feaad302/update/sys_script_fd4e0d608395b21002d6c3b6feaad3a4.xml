		quarter="q3";
	}
	if(month==1 || month==2 || month== 3)
	{
		quarter="q4";
		current.fiscal_year = (year-1)+"-"+(year);
	}
    current.quarter=quarter;
	current.update();
})(current, previous);]]></script>
